#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    time-to-max-speed-ms = <500>;
    trigger-period-ms = <16>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        soft_off {
            bindings = <&soft_off>;
            key-positions = <0 48>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        soft_off: soft_off {
            compatible = "zmk,behavior-soft-off";
            label = "SOFT_OFF";
            #binding-cells = <0>;
            hold-time-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        linux {
            // Ref: https://zmkfirmware.dev/docs/codes/
            // ---  MAIN  -----------------------------------------------------------------------------------------------------------------------
            // |    ESC    |     1     |     2     |     3      |      4      |      5     |                           |      6      |      7     |      8      |      9     |     0    |    BSPC    | |    -/_    |     =/+     |    GRAVE    |
            // |    TAB    |     Q     |     W     |     E      |      R      |      T     |                           |      Y      |      U     |      I      |      O     |     P    |    DEL     | |     \     |      [      |      ]      |
            // |   LCTRL   |     A     |     S     |     D      |      F      |      G     |                           |      H      |      J     |      K      |      L     |     ;    |     '      | |           |      UP     |             |
            // |   SHIFT   |     Z     |     X     |     C      |      V      |      B     |                           |      N      |      M     |      ,      |      .     |     /    |   RSHIFT   | |     L     |      DN     |      R      |
            //                                     |   NUMPAD   |     LALT    |    LCMD    |   SPACE    |  |   ENTER   |   FUNCTION  |  MACOS APP |  MACOS LANG |

            bindings = <
&kp F1        &kp F2     &kp F3           &kp F4        &kp F5             &kp F6           &kp F7            &kp F8              &kp F9        &kp F10           &kp F11   &kp F12            &kp GRAVE  &kp HOME  &kp PAGE_UP
&kp TAB       &kp Q      &kp W            &kp E         &kp R              &kp T            &kp Y             &kp U               &kp I         &kp O             &kp P     &kp BSLH           &kp TILDE  &kp END   &kp PAGE_DOWN
&kp LCTRL     &kp A      &hrm LEFT_ALT S  &hrm LCTRL D  &hrm LEFT_SHIFT F  &hrm LEFT_GUI G  &hrm RIGHT_GUI H  &hrm RIGHT_SHIFT J  &hrm RCTRL K  &hrm RIGHT_ALT L  &kp SEMI  &kp APOS           &kp UP
&kp LEFT_ALT  &kp Z      &kp X            &kp C         &kp V              &kp B            &kp N             &kp M               &kp COMMA     &kp DOT           &kp FSLH  &hrm RSHIFT ENTER  &kp LEFT   &kp DOWN  &kp RIGHT
&kp LCMD      &lt 3 ESC  &lt 1 SPACE      &lt 2 TAB     &lt 2 BACKSPACE    &lt 1 ENTER      &lt 3 DELETE      &kp RIGHT_CONTROL
            >;
        };

        num_nav {
            // ---  FUNCTION  -------------------------------------------------------------------------------------------------------------------
            // | BT Clear  |  BT Prev  |  BT Next  |            |             |            |                           |             |            |             |            |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |             |            |     UP      |            |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |             |    LEFT    |    DOWN     |   RIGHT    |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |             |    MUTE    |  VOL DOWN   |   VOL UP   |          |            | |           |             |             |
            //                                     |            |             |            |            |  |           |             |            |             |

            bindings = <
&bootloader  &sys_reset     &trans  &kp FSLH      &kp LS(STAR)  &trans        &kp PRINTSCREEN  &kp CAPS       &kp SCROLLLOCK  &kp KP_NUMLOCK  &sys_reset     &bootloader  &trans  &trans  &trans
&trans       &kp LS(PIPE)   &kp N7  &kp N8        &kp N9        &kp MINUS     &kp PG_UP        &kp HOME       &kp UP          &kp END         &kp BACKSLASH  &kp PIPE     &trans  &trans  &trans
&kp CAPS     &kp GRAVE      &kp N4  &kp N5        &kp N6        &kp LS(PLUS)  &kp PAGE_DOWN    &kp LEFT       &kp DOWN        &kp RIGHT       &kp PIPE       &trans       &trans
&trans       &kp LS(TILDE)  &kp N1  &kp NUMBER_2  &kp N3        &kp EQUAL     &trans           &kp BACKSPACE  &kp INS         &kp DELETE      &kp BACKSLASH  &trans       &trans  &trans  &trans
&kp N0       &kp DOT        &trans  &trans        &trans        &trans        &trans           &trans
            >;
        };

        sym_mouse {
            // ---  NUMPAD  -------------------------------------------------------------------------------------------------------------------
            // |           |           |           |            |             |            |                           |       =       |      /       |      *       |      -     |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |       7       |      8       |      9       |      +     |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |       4       |      5       |      6       |            |          |            | |           |             |             |
            // |           |           |           |            |             |            |                           |       1       |      2       |      3       |            |          |            | |           |             |             |
            //                                     |            |             |            |            |  |           |       0       |      .       |              |

            bindings = <
&bootloader  &sys_reset     &kp LS(LBRC)  &kp LS(RBRC)   &kp LBKT       &kp RBKT         &msc SCRL_UP    &trans          &trans          &trans           &sys_reset  &bootloader  &trans  &trans  &trans
&trans       &kp BSLH       &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)   &kp LS(RPAR)     &msc SCRL_DOWN  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans      &trans       &trans  &trans  &trans
&trans       &kp MINUS      &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp LS(LBRC)     &kp LBKT        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB4    &trans       &trans
&trans       &kp LS(UNDER)  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)  &kp LS(RBRC)     &kp RBKT        &mkp LCLK       &mkp MCLK       &mkp RCLK        &mkp MB5    &trans       &trans  &trans  &trans
&trans       &trans         &trans        &trans         &trans         &kp KP_NUMBER_0  &kp KP_DOT      &trans
            >;
        };

        misc_media {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans  &trans            &trans        &trans              &trans  &soft_off    &trans  &trans  &trans
&bootloader     &trans        &trans        &bt BT_PRV    &bt BT_NXT    &out OUT_BLE  &trans  &kp C_VOL_DN      &kp C_VOL_UP  &kp K_MUTE          &trans  &bootloader  &trans  &trans  &trans
&sys_reset      &trans        &trans        &trans        &trans        &out OUT_USB  &trans  &kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT          &trans  &sys_reset   &trans
&soft_off       &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &out OUT_TOG  &trans  &trans            &kp C_REWIND  &kp C_FAST_FORWARD  &trans  &trans       &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans        &trans  &trans
            >;
        };

        mac {
            bindings = <
&kp F1        &kp F2     &kp F3           &kp F4       &kp F5             &kp F6           &kp F7            &kp F8              &kp F9       &kp F10           &kp F11    &kp F12            &kp GRAVE  &kp HOME  &kp PAGE_UP
&kp TAB       &kp Q      &kp W            &kp E        &kp R              &kp T            &kp Y             &kp U               &kp I        &kp O             &kp P      &kp BSLH           &kp TILDE  &kp END   &kp PAGE_DOWN
&kp LCMD      &kp LCTRL  &hrm LEFT_ALT S  &hrm RCMD D  &hrm LEFT_SHIFT F  &hrm LEFT_GUI G  &hrm RIGHT_GUI H  &hrm RIGHT_SHIFT J  &hrm LCMD K  &hrm RIGHT_ALT L  &kp RCTRL  &kp APOS           &kp UP
&kp LEFT_ALT  &kp Z      &kp X            &kp C        &kp V              &kp B            &kp N             &kp M               &kp COMMA    &kp DOT           &kp FSLH   &hrm RSHIFT ENTER  &kp LEFT   &kp DOWN  &kp RIGHT
&kp LCTRL     &lt 3 ESC  &lt 1 SPACE      &lt 2 TAB    &lt 2 BACKSPACE    &lt 1 ENTER      &lt 3 DELETE      &kp RIGHT_CONTROL
            >;
        };
    };
};
