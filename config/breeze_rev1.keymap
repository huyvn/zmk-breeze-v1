#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25    // default: 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&mmv {
    time-to-max-speed-ms = <500>;
    trigger-period-ms = <16>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        soft_off {
            bindings = <&softoff>;
            key-positions = <0 48>;
        };
    };

    behaviors {
        hrm: hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };

        softoff: softoff {
            compatible = "zmk,behavior-soft-off";
            label = "SOFTOFF";
            #binding-cells = <0>;
            hold-time-ms = <1000>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        linux {
            bindings = <
&kp F1        &kp F2       &kp F3           &kp F4        &kp F5             &kp F6           &kp F7            &kp F8              &kp F9        &kp F10           &kp F11   &kp F12            &to 4     &kp HOME  &kp PAGE_UP
&kp GRAVE     &kp Q        &kp W            &kp E         &kp R              &kp T            &kp Y             &kp U               &kp I         &kp O             &kp P     &kp BSLH           &softoff  &kp END   &kp PAGE_DOWN
&kp LCTRL     &kp A        &hrm LEFT_ALT S  &hrm LCTRL D  &hrm LEFT_SHIFT F  &hrm LEFT_GUI G  &hrm RIGHT_GUI H  &hrm RIGHT_SHIFT J  &hrm RCTRL K  &hrm RIGHT_ALT L  &kp SEMI  &kp APOS           &kp UP
&kp LEFT_ALT  &kp Z        &kp X            &kp C         &kp V              &kp B            &kp N             &kp M               &kp COMMA     &kp DOT           &kp FSLH  &hrm RSHIFT ENTER  &kp LEFT  &kp DOWN  &kp RIGHT
&kp LCMD      &lt 1 SPACE  &lt 2 TAB        &lt 3 ESCAPE  &lt 3 DELETE       &lt 2 ENTER      &lt 1 BACKSPACE   &kp RIGHT_CONTROL
            >;
        };

        num_nav {
            bindings = <
&bootloader   &sys_reset  &trans  &kp FSLH      &kp ASTRK  &trans     &kp PRINTSCREEN  &kp CAPS       &kp SCROLLLOCK  &kp KP_NUMLOCK  &sys_reset     &bootloader  &trans  &trans  &trans
&trans        &kp PIPE    &kp N7  &kp N8        &kp N9     &kp MINUS  &kp PG_UP        &kp HOME       &kp UP          &kp END         &kp BACKSLASH  &kp PIPE     &trans  &trans  &trans
&kp CAPS      &kp GRAVE   &kp N4  &kp N5        &kp N6     &kp PLUS   &kp PAGE_DOWN    &kp LEFT       &kp DOWN        &kp RIGHT       &kp PIPE       &trans       &trans
&kp DOT       &kp TILDE   &kp N1  &kp NUMBER_2  &kp N3     &kp EQUAL  &trans           &kp BACKSPACE  &kp INS         &kp DELETE      &kp BACKSLASH  &trans       &trans  &trans  &trans
&kp NUMBER_0  &trans      &trans  &trans        &trans     &trans     &trans           &trans
            >;
        };

        sym_mouse {
            bindings = <
&bootloader  &sys_reset     &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp LBKT              &kp RBKT               &msc SCRL_UP    &trans          &trans          &trans           &sys_reset  &bootloader  &trans  &trans  &trans
&trans       &kp BSLH       &kp AMPS        &kp STAR         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &msc SCRL_DOWN  &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &trans      &trans       &trans  &trans  &trans
&trans       &kp MINUS      &kp DOLLAR      &kp PERCENT      &kp CARET             &kp LEFT_BRACE         &kp LBKT        &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB4    &trans       &trans
&trans       &kp LS(UNDER)  &kp EXCL        &kp AT           &kp POUND             &kp RIGHT_BRACE        &kp RBKT        &mkp LCLK       &mkp MCLK       &mkp RCLK        &mkp MB5    &trans       &trans  &trans  &trans
&trans       &trans         &trans          &trans           &trans                &trans                 &trans          &trans
            >;
        };

        misc_media {
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &trans  &trans            &trans        &trans              &trans  &softoff     &trans  &trans  &trans
&bootloader     &trans        &trans        &bt BT_PRV    &bt BT_NXT    &out OUT_BLE  &trans  &kp C_VOL_DN      &kp C_VOL_UP  &kp K_MUTE          &trans  &bootloader  &trans  &trans  &trans
&sys_reset      &trans        &trans        &trans        &trans        &out OUT_USB  &trans  &kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT          &trans  &sys_reset   &trans
&softoff        &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &out OUT_TOG  &trans  &trans            &kp C_REWIND  &kp C_FAST_FORWARD  &trans  &trans       &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &trans        &trans  &trans
            >;
        };

        mac {
            bindings = <
&kp F1        &kp F2       &kp F3           &kp F4        &kp F5             &kp F6           &kp F7            &kp F8              &kp F9       &kp F10           &kp F11    &kp F12            &to 0     &kp HOME  &kp PAGE_UP
&kp GRAVE     &kp Q        &kp W            &kp E         &kp R              &kp T            &kp Y             &kp U               &kp I        &kp O             &kp P      &kp BSLH           &softoff  &kp END   &kp PAGE_DOWN
&kp LCMD      &kp LCTRL    &hrm LEFT_ALT S  &hrm RCMD D   &hrm LEFT_SHIFT F  &hrm LEFT_GUI G  &hrm RIGHT_GUI H  &hrm RIGHT_SHIFT J  &hrm LCMD K  &hrm RIGHT_ALT L  &kp RCTRL  &kp APOS           &kp UP
&kp LEFT_ALT  &kp Z        &kp X            &kp C         &kp V              &kp B            &kp N             &kp M               &kp COMMA    &kp DOT           &kp FSLH   &hrm RSHIFT ENTER  &kp LEFT  &kp DOWN  &kp RIGHT
&kp LCTRL     &lt 1 SPACE  &lt 2 TAB        &lt 3 ESCAPE  &lt 3 DELETE       &lt 2 ENTER      &lt 1 BACKSPACE   &kp RCMD
            >;
        };
    };
};
